{
  "name": "@cyberdudebivash/sentinel-apex-swarm-live",
  "version": "4.46.6",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test src/index.test.mjs scripts/pre-demo-certify.contract.test.mjs",
    "check": "node --check src/index.js && node --check scripts/pre-demo-certify.mjs",
    "deploy:dry": "wrangler deploy --dry-run",
