{
  "name": "@cyberdudebivash/sentinel-apex-swarm-live",
  "version": "4.47.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test src/index.test.mjs src/__tests__/mission-readiness.test.mjs src/__tests__/evidence-graph.test.mjs src/__tests__/mission-profiles.test.mjs scripts/pre-demo-certify.contract.test.mjs scripts/post-demo-certify.contract.test.mjs",
    "check": "node --check src/index.js && node --check src/mission-readiness.js && node --check src/specialist-contract.js && node --check src/evidence-graph.js && node --check src/mission-profiles.js && node --check scripts/release-validate.mjs && node --check scripts/pre-demo-certify.mjs && node --check scripts/post-demo-certify.mjs",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "release:validate": "node scripts/release-validate.mjs",
    "release:validate:live": "node scripts/release-validate.mjs --live-mission",
    "pre-demo:certify": "node scripts/pre-demo-certify.mjs",
    "pre-demo:public": "node scripts/pre-demo-certify.mjs --public-only",
    "post-demo:certify": "node scripts/post-demo-certify.mjs"
  },
  "devDependencies": {
    "wrangler": "4.132.0"
  }
}
